<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <IsPackable>true</IsPackable>

    <!--
      Enable trim analyzers for class libraries.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/prepare-libraries-for-trimming
    -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- NuGet Package Properties -->
  <PropertyGroup>
    <PackageId>Plugin.Maui.Intercom.iOS.Binding</PackageId>
    <Title>Intercom iOS Bindings for Plugin.Maui.Intercom</Title>
    <Authors>kfrancis</Authors>
    <Description>iOS native bindings for Intercom SDK. This package is a dependency of Plugin.Maui.Intercom.</Description>
    <Copyright>Copyright © kfrancis</Copyright>
    <PackageProjectUrl>https://github.com/kfrancis/Plugin.Maui.Intercom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kfrancis/Plugin.Maui.Intercom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet-maui;maui;plugin;intercom;ios;binding;</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>$(BindingPackageVersion)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <XCFramework>NewBindingiOS.xcframework</XCFramework>
    <Framework>NewBinding.framework</Framework>
    <ProjectResources>Intercom.MaciOS.Binding.resources</ProjectResources>
    <RID>ios-arm64</RID>
    <SharpieOutput>sharpie-out</SharpieOutput>
    <Namespace>$(RootNameSpace)</Namespace>
    <SDK>iphoneos</SDK>
    <Scope>Headers Headers/NewBinding-Swift.h</Scope>
  </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>

  <!-- Reference to Xcode project -->
  <ItemGroup>
    <XcodeProject Include="../native/NewBinding/NewBinding.xcodeproj">
      <SchemeName>NewBinding</SchemeName>
    </XcodeProject>
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="libs/Intercom.xcframework">
      <Kind>Framework</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <Visible>true</Visible>
      <Frameworks></Frameworks>
    </NativeReference>
  </ItemGroup>

  <!-- Make resource package creation more resilient on Windows/remote builds.
       Some xcframeworks do not ship all *.private.swiftinterface files.
       The packaging target attempts to copy them and fails with MSB3030 if missing. -->
  <Target Name="_FixupMissingSwiftPrivateInterfaces" BeforeTargets="_CreateBindingResourcePackage">
    <ItemGroup>
      <_MissingSwiftInterfaces Include="$(IntermediateOutputPath)$(ProjectResources)\**\Modules\*.swiftmodule\*.private.swiftinterface"
                              Condition="!'%(FullPath)' == '' and !Exists('%(FullPath)')" />
    </ItemGroup>

    <Message Text="Skipping missing optional swift interfaces: @(_MissingSwiftInterfaces)"
             Importance="low"
             Condition="'@(_MissingSwiftInterfaces)' != ''" />

    <Delete Files="@(_MissingSwiftInterfaces)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="_ExcludeSwiftPrivateInterfacesFromResourcePackage"
          BeforeTargets="_CreateBindingResourcePackage">
    <ItemGroup>
      <BindingResourcePackageFiles Remove="**\*.private.swiftinterface" />
    </ItemGroup>
  </Target>

  <!-- Package content -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>







