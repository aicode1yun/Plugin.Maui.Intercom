<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiSample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Image
                Aspect="AspectFit"
                HeightRequest="185"
                SemanticProperties.Description="dot net bot in a race car number eight"
                Source="intercom.png" />

            <Label
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Headline}"
                Text="Hello, Intercom!" />

            <Label
                SemanticProperties.HeadingLevel="Level2"
                Style="{StaticResource SubHeadline}"
                Text="Test a new binding for Intercom using Native Library Interop" />

            <Button
                Clicked="OnDocsButtonClicked"
                HorizontalOptions="Fill"
                SemanticProperties.Hint="Navigates to getting started documentation"
                Text="NLI Documentation" />

            <Button
                Clicked="OnRepoButtonClicked"
                HorizontalOptions="Fill"
                Text="Plugin Repo" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
