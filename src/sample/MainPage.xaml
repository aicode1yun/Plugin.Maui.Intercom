<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiSample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="15">
            <Image
                Aspect="AspectFit"
                HeightRequest="120"
                SemanticProperties.Description="Intercom logo"
                Source="intercom.png" />

            <Label
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Headline}"
                Text="Hello, Intercom!" />

            <Label
                SemanticProperties.HeadingLevel="Level2"
                Style="{StaticResource SubHeadline}"
                Text="Plugin.Maui.Intercom smoke test" />

            <Label
                x:Name="StatusLabel"
                FontAttributes="Bold"
                Text="Not initialized" />

            <Button
                Clicked="OnInitializeClicked"
                HorizontalOptions="Fill"
                Text="Initialize" />

            <Button
                Clicked="OnRegisterUnidentifiedClicked"
                HorizontalOptions="Fill"
                Text="Register unidentified user" />

            <Button
                Clicked="OnRegisterIdentifiedClicked"
                HorizontalOptions="Fill"
                Text="Register identified user (email)" />

            <Button
                Clicked="OnPresentMessengerClicked"
                HorizontalOptions="Fill"
                Text="Present messenger" />

            <Button
                Clicked="OnPresentComposerClicked"
                HorizontalOptions="Fill"
                Text="Present message composer" />

            <Button
                Clicked="OnPresentHelpCenterClicked"
                HorizontalOptions="Fill"
                Text="Present help center" />

            <Button
                Clicked="OnLogEventClicked"
                HorizontalOptions="Fill"
                Text="Log event" />

            <Button
                Clicked="OnLogoutClicked"
                HorizontalOptions="Fill"
                Text="Logout" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
